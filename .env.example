# Copy to .env and fill in the empty values. Never commit .env.

# Required
OPENROUTER_API_KEY=
APP_ACCESS_CODE=
# At least 32 random characters, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# APP_MODE is not set here on purpose: Docker Compose runs the app in deploy mode (strong
# access code and secret key required, HSTS on). To run uvicorn directly on your machine,
# the app defaults to local mode; add APP_MODE=local only if you start it that way.
PRODUCT_NAME=Controlled Copy

# Models (via OpenRouter, zero-data-retention endpoints only, no data collection)
MODEL_GENERATION=openai/gpt-6-luna
MODEL_GENERATION_FALLBACK=google/gemini-3.5-flash-lite
MODEL_EMBEDDING=baai/bge-m3
EVIDENCE_FLOOR=0.52

# Layers
FEATURE_GOVERNANCE=false
FEATURE_MODEL_PICKER=false
MODEL_CHOICES=openai/gpt-6-luna,openai/gpt-6-luna-pro,openai/gpt-6-sol,google/gemini-3.7-flash,google/gemini-3.5-flash-lite,anthropic/claude-sonnet-5.5,z-ai/glm-5.2

# Retention and limits
RETENTION_HOURS=168
MAX_FILE_BYTES=10485760
MAX_PDF_PAGES=150
MAX_SOURCES_PER_NOTEBOOK=20
MAX_NOTEBOOK_CHARS=2000000
MAX_VISITOR_UPLOAD_MB=200
MAX_TOTAL_UPLOAD_MB=5000
MIN_FREE_DISK_MB=2048
MAX_NOTEBOOKS_PER_VISITOR=5
MAX_QUESTION_CHARS=1500
MAX_SITUATION_CHARS=2000
MODEL_CALLS_PER_VISITOR_HOUR=120
MODEL_CALLS_PER_DAY=3000
MAX_USD_PER_DAY=5
ACCESS_ATTEMPTS_PER_HOUR=10
NEW_SESSIONS_PER_HOUR=30
RESETS_PER_VISITOR_HOUR=10
PROVIDER_TIMEOUT_SECONDS=45
UPLOAD_EMBEDDING_BUDGET_SECONDS=90
MAX_PRICE_PROMPT_PER_MILLION=3
MAX_PRICE_COMPLETION_PER_MILLION=15
MAX_PRICE_EMBEDDING_PER_MILLION=0.1

# Legal: who runs this deployment (privacy notice at /privacy) and the Impressum link (https)
OPERATOR_NAME=
OPERATOR_EMAIL=
IMPRESSUM_URL=

# Docker Compose (Caddy)
SITE_ADDRESS=localhost
PUBLISH_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443

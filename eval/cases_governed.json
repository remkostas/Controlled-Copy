      "case_id": "E-01",
      "title": "Short delivery, 96 of 100",
      "notebook": "demo",
      "situation": "The delivery contains 96 units, but the purchase order expects 100. What should I do?",
      "expected_sources": [
        "SOP-INB-001 rev 3"
      ],
      "also_relevant": [
        "MATRIX-ESC-001 rev 2"
      ],
      "must_not_use": [
        "SOP-INB-001 rev 2"
      ],
      "expected_status": [
        "supported"
      ],
      "expected_warning": null,
      "expected_statement_types": [
        "requirement"
      ],
      "must_say": [
        {
          "what": "the shift lead confirms a recount",
          "any": [
            "\\bshift lead\\b[^.;:]*\\b(?:recount|confirm)",
            "\\b(?:recount|confirm\\w*)\\b[^.;:]*\\bshift lead\\b"
          ]
        },
        {
          "what": "no posting before that",
          "any": [
            "\\b(?:not|never|cannot|can't|don't|mustn't|prohibited|forbidden)\\b[^.;:]*\\bpost",
            "\\buntil\\b[^.;:]*\\bshift lead\\b",
            "\\bbefore\\b[^.;:]*\\bpost",
            "\\bafter\\b[^.;:]*\\b(?:confirm|recount)\\w*[^.;:]*\\bpost"
          ]
        },
        {
          "what": "post the counted quantity",
          "any": [
            "\\bcounted quantity\\b",
            "\\bas counted\\b",
            "\\bpost\\w*\\b[^.;:]*\\b96\\b"
          ]
        }
      ],
      "must_not_say": [
        {
          "what": "post the ordered quantity",
          "any": [
            "\\bpost\\w*\\b{gap}\\bordered quantity\\b"
          ]
        },
        {
          "what": "the shortfall is within tolerance",
          "any": [
            "\\b(?:shortfall|deviation|difference|it|this|4 units|four units)\\b (?:is|falls|lies) (?:\\w+ )?within (?:the )?tolerance"
          ]
        }
      ]
    },

      "detail": [
        {
          "section": "required_actions",
          "type": "requirement",
          "text": "Count every delivery line before posting. Compare the counted quantity with the quantity on the delivery note and on the purchase order.",
          "cites": [
            "SOP-INB-001 rev 3"
          ]
        },
        {
          "section": "required_actions",
          "type": "inference",
          "text": "The 4% shortfall (4 units on 100) exceeds the allowed deviation tolerance of up to 2% of the ordered quantity or 2 units, whichever is smaller, so it requires recount confirmation.",
          "cites": [
            "SOP-INB-001 rev 3",
            "SOP-INB-001 rev 3"
          ]
        },
        {
          "section": "required_actions",
          "type": "requirement",
          "text": "Larger deviations must not be posted until the shift lead has confirmed a recount.",
          "cites": [
            "SOP-INB-001 rev 3"
          ]
        },
        {
          "section": "required_actions",
          "type": "requirement",
          "text": "After the confirmation, post the counted quantity, never the ordered quantity, and record the reason for the deviation.",
          "cites": [
            "SOP-INB-001 rev 3"
          ]
        },
        {
          "section": "escalation",
          "type": "requirement",
          "text": "The shift lead informs purchasing about every confirmed short or over delivery.",
          "cites": [
            "SOP-INB-001 rev 3"
          ]
        }
      ],
      "cited": [

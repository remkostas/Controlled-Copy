{
	# HTTP/1.1 and HTTP/2 only: the server firewall opens TCP 443, not UDP, so advertising
	# HTTP/3 would only make browsers try a port that is closed.
	servers {
		protocols h1 h2
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header -Server
	reverse_proxy app:8000
}
